# ============ Database (PostgreSQL) ============
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/beautyworkspace?schema=public"

# ============ NextAuth ============
# URL приложения (для dev: http://localhost:3000)
NEXTAUTH_URL="http://localhost:3000"
# Секрет для подписи JWT. Сгенерировать: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ============ ЮKassa ============
# https://yookassa.ru/ — Настройки → Магазин
# Если ключи не заданы, платёж работает в MOCK-режиме
# (кнопка «Подтвердить тестовую оплату» на /payment/success).
YOOKASSA_SHOP_ID=""
YOOKASSA_SECRET_KEY=""
# Разрешить вебхуки с любого IP (только для локальной разработки!)
YOOKASSA_WEBHOOK_ALLOW_ALL="false"

# ============ Telegram Bot ============
# Создать бота через @BotFather, получить токен.
TELEGRAM_BOT_TOKEN=""
# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token
TELEGRAM_WEBHOOK_SECRET=""
# Chat ID админа для уведомлений о новых бронях (опционально)
TELEGRAM_ADMIN_CHAT_ID=""

# ============ Cron (напоминания) ============
# Секрет для /api/reminders (Vercel Cron отправляет его в Authorization)
CRON_SECRET=""

# ============ Rate limiting (Upstash Redis, опционально) ============
# Если не задано — используется in-memory fallback (для одного инстанса).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============ Публичный URL приложения ============
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ============ Telegram (публичная часть) ============
# Username бота без @ — показывается мастеру на странице привязки
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""
